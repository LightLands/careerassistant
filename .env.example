# Скопируйте этот файл в .env и заполните. Файл .env никому не отправляйте.

# --- Обязательно ---
BOT_TOKEN=                # токен от @BotFather

# --- Источники вакансий (через запятую: hh, remoteok) ---
ENABLED_SOURCES=hh,remoteok
# hh.ru требует осмысленный User-Agent с контактом: Название/версия (email)
HH_USER_AGENT=CareerAssistantBot/1.0 (your-email@example.com)
# Токен приложения с dev.hh.ru. Нужен, только если hh.ru отвечает 401/403
HH_TOKEN=

# --- ИИ для сопроводительных писем (необязательно) ---
# Без ключа бот подставляет простой шаблон письма.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Если Telegram заблокирован в вашей сети ---
# PROXY_URL=socks5://user:pass@host:1080

# --- Прочее ---
TIMEZONE=Europe/Moscow
DEFAULT_NOTIFY_HOUR=10
DB_PATH=data/career_bot.db
LOG_LEVEL=INFO
